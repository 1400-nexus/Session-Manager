# The nexus-proto generated Python is flat (rx_pb2.py does `import
# common_pb2`), so it must sit on sys.path as top-level modules, not inside a
# package. Required for local (non-installed) runs and for
# `python -c "import rx_pb2, common_pb2"`.
PYTHONPATH=libs/nexus-proto/generated/python

# Every variable is namespaced NEXUS_, so it can't collide with file-monitor,
# s3-sync, or MinIO in a shared compose stack. Relative paths resolve against
# the config file's own directory.
NEXUS_CONFIG=config.toml

NEXUS_STAGING_DIR=./staging
NEXUS_OUTPUT_DIR=./output
NEXUS_JOURNAL_DIR=./journal
NEXUS_RUN_DIR=./run
NEXUS_SOCKET_PATH=./run/session-manager.sock
NEXUS_LOCK_PATH=./run/session-manager.lock

NEXUS_SHM_NAME=nexus-rx
NEXUS_SHM_ARENA_BYTES=268435456
NEXUS_SHM_SLOT_BYTES=4194304

NEXUS_AGGREGATION_POLL_INTERVAL_S=1.0
NEXUS_AGGREGATION_STALL_TIMEOUT_S=8.0
NEXUS_AGGREGATION_SHM_CROSSCHECK=true

# 0 = supervise nothing (the C++ receiver binary is in another repo).
# NEXUS_RECEIVERS_PORTS is comma-separated and must have at least COUNT entries.
NEXUS_RECEIVERS_COUNT=0
NEXUS_RECEIVERS_PORTS=9100,9101,9102
NEXUS_RECEIVERS_BINARY_PATH=./bin/nexus-receiver

NEXUS_STATUS_REFRESH_INTERVAL_S=0.5
NEXUS_STATUS_FORCE_TERMINAL=false

# stall_timeout_seconds is a PLACEHOLDER pending A's sender pacing numbers.
NEXUS_PURGE_SWEEP_INTERVAL_SECONDS=5.0
NEXUS_PURGE_STALL_TIMEOUT_SECONDS=60.0

# Directory of the .proto SOURCE files (not the generated *_pb2.py), hashed
# at startup for the receiver handshake. fec.* are NOT set here -- they arrive
# per-session in the Manifest.
NEXUS_PROTO_CONTRACT_DIR=libs/nexus-proto/proto
