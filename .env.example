# The nexus-proto generated Python is flat (rx_pb2.py does `import
# common_pb2`), so it must sit on sys.path as top-level modules, not inside a
# package. Required for local (non-installed) runs and for
# `python -c "import rx_pb2, common_pb2"`.
PYTHONPATH=libs/nexus-proto/generated/python

# Every environment variable session-manager reads is namespaced NEXUS_, so
# it can't collide with another process's variable of the same generic name
# once this runs in a shared compose stack alongside file-monitor, s3-sync,
# and MinIO.
NEXUS_STAGING_PATH=./staging
NEXUS_SOCKET_PATH=./run/session-manager.sock

# fec.* values are a cross-service contract with the C++ sender/receiver —
# they must match file-monitor exactly. Do not change unilaterally.
NEXUS_FEC_K=200
NEXUS_FEC_N=255
NEXUS_FEC_SYMBOL_BYTES=1400

# Directory of the .proto SOURCE files (not the generated *_pb2.py), hashed
# at startup to detect a stale wire contract. Defaults to the nexus-proto
# submodule's own proto/ directory.
NEXUS_PROTO_CONTRACT_DIR=libs/nexus-proto/proto
